{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davepack-dev",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
  },
  // Bundle the browser code (app/actions/public) into public/js before dev and
  // deploy; wrangler dev rebuilds when anything under app/ changes.
  "build": {
    "command": "node scripts/build-client.mjs",
    "watch_dir": "app",
  },
  // The zone's existing proxied DNS record predates this Worker, so we bind
  // with a zone route (custom domains refuse hostnames that already have
  // externally managed records, and the OAuth token can't edit DNS).
  "routes": [{ "pattern": "davepack.dev/*", "zone_name": "davepack.dev" }],
  // Interaction events from the page (app/actions/events.ts).
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "davepack_events" }],
  "observability": {
    "enabled": true,
  },
}
