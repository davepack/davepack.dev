{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davepack-dev",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "routes": [{ "pattern": "davepack.dev", "custom_domain": true }],
  "observability": {
    "enabled": true
  }
}
