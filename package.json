{
  "name": "davepack-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:client": "node scripts/build-client.mjs",
    "images": "node scripts/make-images.mjs",
    "events": "node --env-file-if-exists=.env.events scripts/events.ts",
    "dashboard": "node --env-file-if-exists=.env.events --import remix/node-tsx tools/dashboard/server.tsx",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'app/**/*.test.ts'",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "^0.27.7",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "latest",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "allowScripts": {
    "workerd@1.20260820.1": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  }
}
