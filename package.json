{
  "name": "davepack-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:client": "esbuild app/actions/public/entry.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=public/js/app.js",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "^0.27.7",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "latest",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "allowScripts": {
    "workerd@1.20260820.1": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  }
}
